{
  "name": "foldyssey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Foldyssey / 一刀万象 — a playable computational paper-art lab.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
